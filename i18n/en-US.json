{
  "_comment": "British to American spelling transform. Applied at runtime to the en-GB source text. Whole-word matches only, case is preserved by the engine.",

  "_policy": [
    "One direction only: en-GB source to en-US output. The source files stay British.",
    "Explicit word pairs, never suffix rules. A blanket -ise to -ize rule would break wise, promise, exercise, paradise and about twenty other words in this corpus.",
    "Every entry below was found in the actual site content. build/extract-strings.py audit flags any new British spelling that appears in content but is missing here."
  ],

  "_excluded": {
    "practice": "British splits practice (noun) and practise (verb). Only the verb forms are listed; the noun is identical in both.",
